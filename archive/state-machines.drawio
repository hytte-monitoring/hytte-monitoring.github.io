        <mxCell id="txt43" value="Rules and notation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=23;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1530" width="1960" height="32" />
        </mxCell>
        <mxCell id="txt44" value="coldRequired: system policy says cold-weather protection is needed; false means it is safe to restore user choices." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1574" width="1960" height="27" />
        </mxCell>
        <mxCell id="txt45" value="powerOK / internetOK: current availability of normal cabin electricity / normal Internet." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1605" width="1960" height="27" />
        </mxCell>
        <mxCell id="txt46" value="Smoke, Internet/Connection and Outdoor Temperature remain monitored; cold conditions force Indoor Temperature and Power." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1636" width="1960" height="27" />
        </mxCell>
        <mxCell id="txt47" value="The four regions run concurrently. Waiting for HOME/AWAY does not pause mandatory monitoring or infrastructure fallback." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1667" width="1960" height="27" />
        </mxCell>
        <mxCell id="txt48" value="Incident creation starts the second diagram. A worsening Warning updates the same Incident; monitoring continues." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1698" width="1960" height="27" />
        </mxCell>
        <mxCell id="txt49" value="Backup selection is independent of the optional Power monitoring preference. All external effects are simulated." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1729" width="1960" height="27" />
        </mxCell>
        <mxCell id="txt50" value="Source: ground_truth.md sections 4–7, 14–15, 18–19. Dashed separators represent orthogonal UML regions." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=16;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1763" width="1960" height="25" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

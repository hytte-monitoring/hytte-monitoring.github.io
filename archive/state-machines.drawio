        <mxCell id="txt34" value="Rules and notation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=23;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1925" width="2340" height="32" />
        </mxCell>
        <mxCell id="txt35" value="DANGER = severity == Critical AND immediateCriticalDanger." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1969" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt36" value="EMERGENCY_OK = severity == Critical AND autoEmergencyEnabled AND emergencyAssistanceRequired." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2000" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt37" value="G1 = ownerDue AND contactsConfigured AND NOT DANGER." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2031" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt38" value="G2 = ownerDue AND NOT contactsConfigured AND EMERGENCY_OK AND NOT DANGER." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2062" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt39" value="G3 = contactDue AND EMERGENCY_OK AND NOT DANGER." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2093" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt40" value="ownerDue / contactDue: the current system-controlled response or follow-up deadline has elapsed." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2124" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt41" value="assess is queued after creation, deadline expiry and relevant response, severity, danger or configuration changes." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2155" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt42" value="promote() immediately re-notifies the owner, updates the same record and tightens the pending deadline; stages are preserved." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2186" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt43" value="Not Resolved / contactResponse keep the Incident Active. markResolved closes it from any combination of substates." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2217" width="2340" height="27" />
        </mxCell>
        <mxCell id="txt44" value="Source: ground_truth.md sections 7–13, 18–19. See notater.md for action definitions and scenario checks." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=16;fontColor=#64748b;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2243" width="2340" height="25" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

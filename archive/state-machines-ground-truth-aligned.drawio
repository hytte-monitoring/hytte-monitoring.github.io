        <mxCell id="monitoring_rules" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="3, 4, 6, 15, 18" umlKind="note">
          <mxGeometry x="60" y="1570" width="1100" height="256" as="geometry" />
        </mxCell>
        <mxCell id="monitoring_rules_head" value="Monitoring constraints  [GT 3-6, 15; ADR-001]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="monitoring_rules">
          <mxGeometry x="16" y="12" width="1068" height="29" as="geometry" />
        </mxCell>
        <mxCell id="monitoring_rules_text" value="Smoke and Internet/Connection are always mandatory.&#10;The local Outdoor Temperature Sensor remains monitored for cold protection.&#10;Indoor Temperature and Power are mandatory while protection is active;&#10;otherwise they follow owner choices. Water Leak, Door and Motion are optional.&#10;HOME/AWAY changes security behavior; it does not suspend enabled safety,&#10;environmental or system monitoring." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="monitoring_rules">
          <mxGeometry x="16" y="51" width="1068" height="196" as="geometry" />
        </mxCell>
        <mxCell id="safety_rules" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="4, 5, 7, 15" umlKind="note">
          <mxGeometry x="1200" y="1570" width="1100" height="256" as="geometry" />
        </mxCell>
        <mxCell id="safety_rules_head" value="Configuration and detection priority  [GT 4-5, 7, 15]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="safety_rules">
          <mxGeometry x="16" y="12" width="1068" height="29" as="geometry" />
        </mxCell>
        <mxCell id="safety_rules_text" value="Owner-configurable detection/notification levels stay within allowed safe ranges.&#10;The system controls Critical thresholds; users cannot disable or weaken them.&#10;Critical notifications are immediate despite normal notification preferences.&#10;Smoke and Internet/Connection cannot be disabled; Indoor Temperature and&#10;Power cannot be disabled during cold protection. The cold threshold is&#10;system-controlled and cannot be changed by the owner." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="safety_rules">
          <mxGeometry x="16" y="51" width="1068" height="196" as="geometry" />
        </mxCell>
        <mxCell id="parameters" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="3, 4, 14, 16" umlKind="note">
          <mxGeometry x="60" y="1850" width="1100" height="244" as="geometry" />
        </mxCell>
        <mxCell id="parameters_head" value="Guards and recovery  [GT 3-4, 14, 16]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="parameters">
          <mxGeometry x="16" y="12" width="1068" height="29" as="geometry" />
        </mxCell>
        <mxCell id="parameters_text" value="coldRequired: the cabin Outdoor Temperature Sensor and system threshold&#10;require protection; false means conditions are safe to restore prior choices.&#10;powerOK / internetOK: availability of normal cabin electricity / Internet.&#10;Power and communication regions act independently, including simultaneous&#10;outages. Restoration automatically returns the affected region to normal.&#10;No external Weather Service is involved." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="parameters">
          <mxGeometry x="16" y="51" width="1068" height="184" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="1, 2, 7, 8, 9, 14, 15, 16, 17, 18, 19" umlKind="note">
          <mxGeometry x="1200" y="1850" width="1100" height="244" as="geometry" />
        </mxCell>
        <mxCell id="scope_head" value="Lifecycle boundary and notation  [GT 1-2, 7-9, 14-19]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="scope">
          <mxGeometry x="16" y="12" width="1068" height="29" as="geometry" />
        </mxCell>
        <mxCell id="scope_text" value="Dashed boundaries separate concurrent UML regions. Each has an initial node.&#10;Awaiting HOME/AWAY does not pause mandatory monitoring or fallback.&#10;Incident creation starts the separate Incident Lifecycle; monitoring continues.&#10;No system shutdown behavior is specified. Login, dashboard/history viewing&#10;and actor interactions are outside this operational-state view. All external&#10;effects are conceptual and simulated; no extra failure policy is introduced." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="scope">
          <mxGeometry x="16" y="51" width="1068" height="184" as="geometry" />
        </mxCell>
        <mxCell id="authority" value="Authority: model/Ground_truth.md only. State/action labels are conceptual UML specification, not implementation code." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#51677e;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="2124" width="2240" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

          <mxGeometry x="1" y="52" width="968" height="0" as="geometry" />
        </mxCell>
        <mxCell id="closed_body" value="entry / close the SAME Incident;&#10;update its existing History record to Closed" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="closed">
          <mxGeometry x="18" y="65" width="934" height="63" as="geometry" />
        </mxCell>
        <mxCell id="I15" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=0;strokeColor=#334155;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="active" target="closed" umlLabel="Hytte Owner/User selects Resolved" groundTruthSections="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="I15_label" value="Hytte Owner/User selects Resolved" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#334155;fontStyle=0;spacing=0;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1493" width="590" height="31" as="geometry" />
        </mxCell>
        <mxCell id="family_policy" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="8, 10, 11, 12, 13" umlKind="note">
          <mxGeometry x="60" y="1732" width="1170" height="236" as="geometry" />
        </mxCell>
        <mxCell id="family_policy_head" value="Family escalation and waiting constraints  [GT 8, 10-13]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="family_policy">
          <mxGeometry x="16" y="12" width="1138" height="29" as="geometry" />
        </mxCell>
        <mxCell id="family_policy_text" value="familyEscalationDue represents an eligible family-notification step after the&#10;applicable system-determined wait: the owner has not responded, or the&#10;Incident remains Active after Not Resolved. Only configured contacts are used.&#10;Waiting is severity-dependent and cannot be configured by the owner.&#10;Warnings may reach Family/Emergency Contacts, never an official Emergency&#10;Service. Due events are abstract policy events, not timer or retry algorithms." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="family_policy">
          <mxGeometry x="16" y="51" width="1138" height="176" as="geometry" />
        </mxCell>
        <mxCell id="emergency_policy" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="10, 11, 12, 15, 18" umlKind="note">
          <mxGeometry x="1260" y="1732" width="1200" height="236" as="geometry" />
        </mxCell>
        <mxCell id="emergency_policy_head" value="Normal Critical escalation and safety override  [GT 10-12, 15]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="emergency_policy">
          <mxGeometry x="16" y="12" width="1168" height="29" as="geometry" />
        </mxCell>
        <mxCell id="emergency_policy_text" value="EMERGENCY_OK = Critical AND automatic emergency escalation enabled&#10;AND emergency assistance required. normalCriticalEscalationDue also requires&#10;the applicable waiting and human-first order: owner, then configured contacts;&#10;contact non-response permits onward escalation. If none are configured, skip them.&#10;DANGER = Critical AND immediate critical danger. safetyAssessment applies at&#10;creation, upgrade and changed danger; DANGER bypasses normal waits/preferences." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="emergency_policy">
          <mxGeometry x="16" y="51" width="1168" height="176" as="geometry" />
        </mxCell>
        <mxCell id="open_policies" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="7, 8, 10, 11, 12, 13, 19" umlKind="note">
          <mxGeometry x="60" y="1994" width="1170" height="281" as="geometry" />
        </mxCell>
        <mxCell id="open_policies_head" value="Explicitly unspecified by Ground Truth - clarification required" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="open_policies">
          <mxGeometry x="16" y="12" width="1138" height="29" as="geometry" />
        </mxCell>
        <mxCell id="open_policies_text" value="On Warning-to-Critical upgrade: the remaining escalation stage and deadline.&#10;After Not Resolved or repeated replies: timer origins and reset behavior.&#10;After a Family/Emergency Contact replies: effects if still unresolved, and&#10;whether that person may report resolution with any system effect.&#10;The abstract escalation events leave these policies unspecified. No stage&#10;retention/restart, follow-up reset, retry or contact-resolution rule is chosen.&#10;They constrain permitted escalation; they do not complete the missing policies." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="open_policies">
          <mxGeometry x="16" y="51" width="1138" height="221" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_rules" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1" groundTruthSections="7, 8, 9, 14, 17" umlKind="note">
          <mxGeometry x="1260" y="1994" width="1200" height="281" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_rules_head" value="Identity, concurrency and lifecycle boundary  [GT 7-9, 14, 17]" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#132d49;fontStyle=1;spacing=0;" vertex="1" parent="lifecycle_rules">
          <mxGeometry x="16" y="12" width="1168" height="29" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_rules_text" value="Warning/Critical are severity, not separate Incidents. Upgrade creates no new&#10;Incident or History record. Every modeled escalation updates the same record.&#10;Dashed boundaries denote concurrent regions: guidance does not suspend&#10;eligible escalation. Owner resolution closes the Incident from any Active substate.&#10;No notification or Emergency Service contact automatically closes the Incident.&#10;Closed is terminal here; its History remains viewable and system monitoring&#10;continues. Effects are conceptual/simulated; no extra failure behavior is specified." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;spacing=0;" vertex="1" parent="lifecycle_rules">
          <mxGeometry x="16" y="51" width="1168" height="221" as="geometry" />
        </mxCell>
        <mxCell id="authority" value="Authority: model/Ground_truth.md only. The amber policy view deliberately leaves unanswered Ground Truth choices open; verified 100% is not claimed." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#51677e;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="2310" width="2400" height="42" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>